# Administrateur créé au premier démarrage s’il n’existe aucun admin.
CORTEX_ADMIN_EMAIL=admin@cortex.local
CORTEX_ADMIN_PASSWORD=cortex-admin

# Dossier des comptes, états et archives (un fichier par compte).
# Local : .cortex-data
# Vercel : /tmp/cortex-data (éphémère) — pour une démo durable, hébergez
# l’API sur un VPS et pointez CORTEX_DATA_DIR vers un volume persistant.
# CORTEX_DATA_DIR=

# Cookie session HTTPS (à activer derrière un reverse-proxy TLS).
# CORTEX_SECURE_COOKIE=1
# CORTEX_CORS_ORIGIN=*

# Envoi réel des mails. Sans SMTP, les messages restent dans la file admin.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=CORTEX <noreply@cortex.local>
